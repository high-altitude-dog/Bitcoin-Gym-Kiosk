# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://medusa:YOUR_PASSWORD@localhost:5432/bitcoin_gym_kiosk
REDIS_URL=redis://localhost:6379

# Secrets: generate long random strings
JWT_SECRET=
COOKIE_SECRET=

# Coinos (Lightning only)
COINOS_API_URL=https://coinos.io/api
COINOS_API_TOKEN=
# Shared secret sent on every invoice we create; Coinos echoes it back on the
# webhook call so we can check it before trusting the callback. Generate a
# long random string, don't reuse it elsewhere.
COINOS_WEBHOOK_SECRET=
# Optional. What Coinos creates: lightning (BOLT11 invoice, the default) or
# bolt12 (an offer; for testing only so far). Leave unset for lightning.
COINOS_INVOICE_TYPE=
# Publicly reachable base URL of this Medusa backend, used to build the
# Coinos webhook callback. Coinos must be able to reach it over the internet,
# so localhost only works once tunneled (e.g. via ngrok) or once deployed.
MEDUSA_BACKEND_URL=http://localhost:9000

# Baneco API (bank QR in Bs)
BANECO_API_URL=
BANECO_CLIENT_ID=
BANECO_CLIENT_SECRET=

# Yadio rates
YADIO_API_URL=https://api.yadio.io

# Slack alerts for the kiosk (sales, low stock, paid-but-no-order,
# reconciliation). An incoming webhook URL from a Slack app; it's a secret.
# Leave empty to turn alerts off.
SLACK_WEBHOOK_URL=

# Optional extra channels, each its own incoming webhook (secrets too).
# Staff hand-overs (product Type "Entrega del personal") and the partner
# café's orders (Type "Café asociado"). Unset, they go to the channel above.
SLACK_STAFF_WEBHOOK_URL=
SLACK_CAFE_WEBHOOK_URL=
# "Bitcoin Ark" through our self-hosted Bark Pay (optional; unset hides the option).
# BARKPAY_API_KEY is a secret key (sk_live_...) and BARKPAY_WEBHOOK_SECRET the
# webhook endpoint's signing secret (whsec_...), both from Bark Pay.
BARKPAY_URL=https://bark.paywithbitcoin.lol
BARKPAY_API_KEY=
BARKPAY_WEBHOOK_SECRET=
