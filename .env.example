# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://medusa:YOUR_PASSWORD@localhost:5432/perseus
REDIS_URL=redis://localhost:6379

# Secrets: generate long random strings
JWT_SECRET=
COOKIE_SECRET=

# Coinos (Lightning only)
COINOS_API_URL=https://coinos.io/api
COINOS_API_TOKEN=
# Shared secret sent on every invoice we create; Coinos echoes it back on the
# webhook call so we can check it before trusting the callback. Generate a
# long random string, don't reuse it elsewhere.
COINOS_WEBHOOK_SECRET=
# Publicly reachable base URL of this Medusa backend, used to build the
# Coinos webhook callback. Coinos must be able to reach it over the internet,
# so localhost only works once tunneled (e.g. via ngrok) or once deployed.
MEDUSA_BACKEND_URL=http://localhost:9000

# Baneco API (bank QR in Bs)
BANECO_API_URL=
BANECO_CLIENT_ID=
BANECO_CLIENT_SECRET=

# Yadio rates
YADIO_API_URL=https://api.yadio.io
